# ---------------------------------------------------------------------
# Copy this file to .env.local and fill in your own values.
#
#   cp .env.example .env.local
#
# .env.local is listed in .gitignore and must NEVER be committed.
# Requirement 10: no credential is hard-coded anywhere in the source.
# ---------------------------------------------------------------------

# --- PostgreSQL connection -------------------------------------------
# Either set DATABASE_URL, or the individual PG* variables below.
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/pokerdb

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=pokerdb
PGPOOL_MAX=10

# --- Session signing --------------------------------------------------
# Any random string of 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_this_with_a_long_random_string_at_least_32_chars

# --- Seed data --------------------------------------------------------
# Password given to every generated demo account. Change it before any
# deployment that is reachable from outside your machine.
SEED_PASSWORD=Passw0rd!
# Size of the generated dataset: small | medium | large
SEED_SIZE=medium

# --- Embeddings -------------------------------------------------------
# local  : deterministic 256-d lexical model, no network needed (default)
# openai : text-embedding-3-small, requires OPENAI_API_KEY
EMBEDDING_PROVIDER=local
# OPENAI_API_KEY=

# --- Development ------------------------------------------------------
# Set to true to print every SQL statement and its timing to the console.
LOG_SQL=false
